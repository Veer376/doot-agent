FROM python:3.13-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy orbit-core
COPY packages/orbit-core /app/packages/orbit-core
WORKDIR /app/packages/orbit-core
RUN pip install -e .

# Copy orbit-api
WORKDIR /app
COPY packages/orbit-api /app/packages/orbit-api
WORKDIR /app/packages/orbit-api
RUN pip install -e .

# Set working directory to orbit-api for runtime
WORKDIR /app/packages/orbit-api

# Expose port
EXPOSE 8000

# Run the FastAPI app
CMD ["uvicorn", "agent_platform.app.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
