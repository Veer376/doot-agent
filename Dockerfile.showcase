FROM python:3.13-slim
WORKDIR /app
RUN pip install --no-cache-dir uv
COPY pyproject.toml uv.lock ./
COPY packages/orbit-core ./packages/orbit-core
COPY packages/agent-platform ./packages/agent-platform
RUN uv sync --frozen --no-dev
COPY langgraph.showcase.json ./
COPY examples ./examples
ENV PATH="/app/.venv/bin:$PATH"
CMD ["uvicorn", "agent_platform.api.main:app", "--host", "0.0.0.0", "--port", "5000"]
